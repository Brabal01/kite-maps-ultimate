--- /dev/null
+++ b/VelaCore/Sources/VelaCore/VignetteRoads.swift
@@ -0,0 +1,123 @@
+import Foundation
+
+public enum VignetteRoads {
+    /// Czech toll-tagged motorway sections whose mapped geometry agrees with the selected route.
+    /// This is positive-only: an empty response is never evidence that the drive is exempt.
+    public static func czechMotorways(on line: [LatLng]) async -> [String] {
+        guard line.count >= 2, line.contains(where: { (48.5...51.1).contains($0.lat) && (12...19).contains($0.lng) }) else { return [] }
+        let official = CzechVignetteMap.roads(on: line)
+        if !official.isEmpty { return official }
+        let cumulative = Geo.cumulative(line)
+        var references = Set<String>()
+        let locale = Locale(identifier: "en_US_POSIX")
+        for piece in Overpass.pieces(line, meters: 70_000) {
+            guard !Task.isCancelled else { return [] }
+            let candidates = piece.filter { (48.5...51.1).contains($0.lat) && (12...19).contains($0.lng) }
+            guard candidates.count >= 2 else { continue }
+            let step = max(1, (candidates.count + 199) / 200)
+            let coordinates = (stride(from: 0, to: candidates.count, by: step).map { candidates[$0] } + [candidates[candidates.count - 1]])
+                .map { String(format: "%.5f,%.5f", locale: locale, $0.lat, $0.lng) }.joined(separator: ",")
+            let query = """
+            [out:json][timeout:14];
+            area["ISO3166-1"="CZ"]["admin_level"="2"]->.country;
+            way["highway"="motorway"]["toll"="yes"](area.country)(around:24,\(coordinates));
+            out body geom 300;
+            """
+            guard let data = await Overpass.firstAnswer(query, stagger: 4, valid: { elements($0) != nil }) else { continue }
+            for way in elements(data) ?? [] {
+                guard let ref = (way["tags"] as? [String: String])?["ref"], !ref.isEmpty,
+                      let geometry = way["geometry"] as? [[String: Double]] else { continue }
+                let points = geometry.compactMap { item -> LatLng? in
+                    guard let lat = item["lat"], let lng = item["lon"] else { return nil }
+                    return LatLng(lat, lng)
+                }
+                let hits = points.map { Geo.project($0, on: line, cumulative: cumulative) }
+                    .filter { $0.offset < 15 }.map(\.along)
+                if let low = hits.min(), let high = hits.max(), high - low > 150 { references.insert(ref) }
+            }
+        }
+        return references.sorted()
+    }
+
+    private static func elements(_ data: Data) -> [[String: Any]]? {
+        (try? JSONSerialization.jsonObject(with: data) as? [String: Any])?["elements"] as? [[String: Any]]
+    }
+}
+
+extension VignetteRoads {
+    /// Positive matches only. Incomplete map tags never mean a route is toll-free.
+    public static func hasMappedToll(on line: [LatLng]) async -> Bool {
+        guard line.count >= 2 else { return false }
+        if !CzechVignetteMap.roads(on: line).isEmpty || !RoadCharges.on(line).isEmpty { return true }
+        return await withTaskGroup(of: Bool.self) { group in
+            group.addTask { await Valhalla.toll(on: line) }
+            group.addTask { await mappedToll(on: line) }
+            for await found in group where found {
+                group.cancelAll()
+                return true
+            }
+            return false
+        }
+    }
+
+    private static func mappedToll(on line: [LatLng]) async -> Bool {
+        let locale = Locale(identifier: "en_US_POSIX")
+        for piece in Overpass.pieces(line, meters: 60_000) {
+            if Task.isCancelled { return false }
+            let step = max(1, (piece.count + 179) / 180)
+            let samples = stride(from: 0, to: piece.count, by: step).map { piece[$0] } + [piece[piece.count - 1]]
+            let coordinates = samples.map { String(format: "%.5f,%.5f", locale: locale, $0.lat, $0.lng) }.joined(separator: ",")
+            let query = """
+            [out:json][timeout:14];
+            (
+              way["highway"]["toll"="yes"]["toll:motorcar"!="no"]["toll:motor_vehicle"!="no"](around:22,\(coordinates));
+              way["highway"]["toll:motorcar"="yes"](around:22,\(coordinates));
+              way["highway"]["toll:motor_vehicle"="yes"]["toll:motorcar"!="no"](around:22,\(coordinates));
+              way["highway"]["toll:forward"="yes"](around:22,\(coordinates));
+              way["highway"]["toll:backward"="yes"](around:22,\(coordinates));
+            );
+            out geom 400;
+            """
+            guard let data = await Overpass.firstAnswer(query, stagger: 4, valid: { elements($0) != nil }) else { continue }
+            if containsToll(elements(data) ?? [], on: piece) { return true }
+        }
+        return false
+    }
+
+    static func containsToll(_ ways: [[String: Any]], on line: [LatLng]) -> Bool {
+        let routeDistances = Geo.cumulative(line)
+        guard line.count >= 2 else { return false }
+        for way in ways {
+            let tags = way["tags"] as? [String: String] ?? [:]
+            let both = tags["toll"] == "yes" || tags["toll:motorcar"] == "yes" || tags["toll:motor_vehicle"] == "yes"
+            let forward = both || tags["toll:forward"] == "yes"
+            let backward = both || tags["toll:backward"] == "yes"
+            guard let geometry = way["geometry"] as? [[String: Double]] else { continue }
+            let points = geometry.compactMap { item -> LatLng? in
+                guard let lat = item["lat"], let lng = item["lon"] else { return nil }
+                return LatLng(lat, lng)
+            }
+            guard points.count >= 2 else { continue }
+            let distances = Geo.cumulative(points)
+            guard let length = distances.last, length >= 25 else { continue }
+            let interval = max(20, length / 80)
+            var previous: Double?
+            for at in stride(from: 0, through: length, by: interval) {
+                let point = Geo.point(along: points, meters: at, cumulative: distances)
+                let match = Geo.project(point, on: line, cumulative: routeDistances)
+                if match.offset <= 14 {
+                    if let previous {
+                        let delta = match.along - previous
+                        let threshold = min(16, interval * 0.7)
+                        if ((forward || tags.isEmpty) && delta >= threshold)
+                            || ((backward || tags.isEmpty) && delta <= -threshold) { return true }
+                    }
+                    previous = match.along
+                } else {
+                    previous = nil
+                }
+            }
+        }
+        return false
+    }
+}
