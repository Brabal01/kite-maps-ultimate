+struct JustDriveView: View {
+    @ObservedObject var model: AppModel
+    @ObservedObject private var settings = AppSettings.shared
+
+    private var nearbyEvents: [UpcomingRoadControl] {
+        guard let here = model.userLatLng else { return [] }
