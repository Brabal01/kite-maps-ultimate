--- /dev/null
+++ b/App/Sources/JourneyActivity.swift
@@ -0,0 +1,34 @@
+import ActivityKit
+import Foundation
+
+@available(iOS 16.2, *)
+@MainActor
+final class JourneyActivity {
+    static let shared = JourneyActivity()
+    private var current: Activity<TripActivity>?
+    private var last: TripActivity.ContentState?
+    private var lastUpdate = Date.distantPast
+
+    func show(_ state: TripActivity.ContentState) {
+        guard ActivityAuthorizationInfo().areActivitiesEnabled else { return }
+        let now = Date()
+        guard state != last || now.timeIntervalSince(lastUpdate) > 40 else { return }
+        guard state.instruction != last?.instruction || now.timeIntervalSince(lastUpdate) >= 3 else { return }
+        let content = ActivityContent(state: state, staleDate: now.addingTimeInterval(90))
+        if let activity = current ?? Activity<TripActivity>.activities.first {
+            current = activity
+            Task { await activity.update(content) }
+        } else {
+            current = try? Activity.request(attributes: TripActivity(), content: content)
+        }
+        if current != nil { last = state; lastUpdate = now }
+    }
+
+    func finish() {
+        let sessions = Activity<TripActivity>.activities
+        current = nil
+        last = nil
+        lastUpdate = .distantPast
+        for activity in sessions { Task { await activity.end(nil, dismissalPolicy: .immediate) } }
+    }
+}
